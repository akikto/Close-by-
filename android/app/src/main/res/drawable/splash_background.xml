<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#34C49F"
                android:startColor="#75C9F1"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:bottom="80dp"
        android:left="80dp"
        android:right="80dp"
        android:top="80dp">
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_closeby_logo" />
    </item>
</layer-list>
