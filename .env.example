# Close by — environment configuration example
# Copy to `local.properties` (Android-safe, git-ignored) as:
#   SUPABASE_URL=...
#   SUPABASE_ANON_KEY=...
#
# NEVER commit real values. This file only documents the required keys.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase anon/public API key (safe for client apps — RLS policies
# enforce access control server-side, they are NOT a secret admin key)
SUPABASE_ANON_KEY=
